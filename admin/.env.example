# Local: the API directly. Production: the admin's own origin + /v1, proxied to
# the API by functions/v1/[[path]].ts (set API_PROXY_TARGET on the Pages
# project), so the session cookie is first-party. Pointing production straight
# at the API makes get-session return null.
VITE_APP_API_URL=http://localhost:3001/v1
VITE_APP_ASSETS_URL=
