{
  "compilerOptions": {
    "lib": ["es2023"],
    "outDir": "./dist",
    "module": "nodenext",
    "moduleResolution": "node16",
    "target": "es2022",
    "resolveJsonModule": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "composite": false,
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src", "tests", "index.d.ts"],
  "exclude": ["**/node_modules", "**/.*/"]
}
