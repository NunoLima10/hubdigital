NODE_ENV=development
PORT=3001
HOST=0.0.0.0

COOKIE_SECRET=changeme-super-secret-at-least-32-chars

BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=changeme-super-secret-at-least-32-chars

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hubdigital
DB_MIGRATING=false
DB_SEEDING=false

ADMIN_SEED_NAME=Admin User
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me-strong-password

# Google OAuth web client. Register this local callback URI in Google Cloud:
# http://localhost:3001/v1/auth/callback/google
# In production use: https://your-api-domain.com/v1/auth/callback/google
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional: GitHub sign-in is not offered yet.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Per account when signed in, per IP otherwise.
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_WINDOW_MS=60000
# X-Forwarded-For hops to trust: false (direct), a hop count such as 1 behind
# one load balancer, true, or a comma-separated list of proxy IPs/CIDRs.
TRUST_PROXY=false
# Shared with the web server (same value as its API_INTERNAL_KEY), at least
# 32 characters. Lets server-side renders be limited per visitor.
API_INTERNAL_KEY=

# Cloudflare R2 (project logo/banner uploads)
# Without these, POST /v1/uploads answers 503 and the rest of the API works normally.
CLOUDFLARE_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
CLOUDFLARE_BUCKET=dev-hubdigital
CLOUDFLARE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_ACCESS_KEY_SECRET=your-r2-secret-access-key
CLOUDFLARE_REGION=auto
UPLOADER_URL_EXPIRES_IN=300
