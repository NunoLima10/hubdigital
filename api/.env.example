NODE_ENV=development
PORT=3000
HOST=0.0.0.0

COOKIE_SECRET=changeme-super-secret-at-least-32-chars

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=changeme-super-secret-at-least-32-chars

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hubdigital
DB_MIGRATING=false
DB_SEEDING=false

ADMIN_SEED_NAME=Admin User
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me-strong-password

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
