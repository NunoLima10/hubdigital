NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

COOKIE_SECRET=replace-with-a-local-cookie-secret
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Match HUBDIGITAL_DB_PASSWORD in the repository root .env (URL-encode if needed).
DATABASE_URL=postgres://postgres:REPLACE_WITH_YOUR_DB_PASSWORD@localhost:5432/hubdigitaldb
DB_MIGRATING=true
DB_SEEDING=true

# Google sign-in is optional during local email/password development, but the
# API configuration expects values to be present.
GOOGLE_CLIENT_ID=local-development-client
GOOGLE_CLIENT_SECRET=local-development-secret

# Optional production/integration settings.
API_INTERNAL_KEY=
ADMIN_SEED_NAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# Public site stats (home sidebar): personal key with only query:read.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_APP_HOST=https://eu.posthog.com
CLOUDFLARE_PUBLIC_URL=
CLOUDFLARE_BUCKET=
CLOUDFLARE_ENDPOINT=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_ACCESS_KEY_SECRET=
CLOUDFLARE_REGION=auto
UPLOADER_URL_EXPIRES_IN=300
