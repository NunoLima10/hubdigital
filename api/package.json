{
  "name": "@hubdigital/api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx --watch --env-file .env src/main.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/main.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file .env src/scripts/seeds.ts",
    "dbml:generate": "tsx src/db/dbml.ts",
    "better-auth:gen": "npx @better-auth/cli generate --output src/db/schemas/auth.ts --yes",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.8.0",
  "devDependencies": {
    "@testcontainers/postgresql": "^10.10.3",
    "@types/node": "^22.15.23",
    "drizzle-dbml-generator": "^0.10.0",
    "drizzle-kit": "^0.31.1",
    "testcontainers": "^10.10.3",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/error": "^4.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.2",
    "better-auth": "^1.3.6",
    "drizzle-orm": "^0.41.0",
    "drizzle-zod": "^0.7.0",
    "fastify": "^5.3.3",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.7",
    "zennv": "^0.1.1",
    "zod": "^3.24.2"
  }
}
