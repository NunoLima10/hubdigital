{
  "name": "@hubdigital/api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx --watch --env-file .env src/main.ts",
    "build": "pnpm --filter @hubdigital/shared build && tsc && tsc-alias",
    "start": "node dist/main.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file .env src/scripts/seeds.ts",
    "dbml:generate": "tsx src/db/dbml.ts",
    "better-auth:gen": "npx @better-auth/cli generate --output src/db/schemas/auth.ts --yes",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.8.0",
  "devDependencies": {
    "@testcontainers/postgresql": "^10.28.0",
    "@types/node": "^22.20.5",
    "drizzle-dbml-generator": "^0.10.0",
    "drizzle-kit": "^0.31.11",
    "testcontainers": "^10.28.0",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/error": "^4.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^5.2.6",
    "@hubdigital/shared": "workspace:*",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.7.1",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^4.0.2",
    "isbot": "^5.2.2",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "pino-pretty": "^13.2.0",
    "postgres": "^3.4.9",
    "zennv": "^0.1.1",
    "zod": "^3.25.76"
  }
}
