VITE_APP_API_URL=http://localhost:3001/v1
VITE_APP_ASSETS_URL=
# Public origin of the site, no trailing slash (https://hubdigital.cv in production).
VITE_APP_SITE_URL=http://localhost:5173
# Optional map tiles (Leaflet URL template + attribution). Empty uses CARTO's free basemaps.
VITE_APP_MAP_TILE_URL=
VITE_APP_MAP_TILE_ATTRIBUTION=
# Optional Umami analytics; the script URL only changes when self-hosting.
VITE_APP_UMAMI_WEBSITE_ID=
VITE_APP_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
