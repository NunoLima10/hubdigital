# Loaded by `vite build --mode staging` (pnpm build:staging / deploy:staging),
# on top of .env. CLOUDFLARE_ENV makes the Cloudflare Vite plugin build for the
# "staging" environment in wrangler.jsonc. The deploy script also passes
# `--env staging` to Wrangler so the built Worker is published to that
# environment rather than production.
CLOUDFLARE_ENV=staging

# VITE_APP_* are inlined into the bundle at build time (they are public), so
# the staging build needs its own. Uncomment and point them at the staging
# stack; anything left commented falls back to .env.
# The API goes through the Worker's own origin (API_PROXY_TARGET in
# wrangler.jsonc proxies /v1 to Railway), so its cookies are first-party.
VITE_APP_API_URL=https://hubdigital-web-staging.codeisland1460.workers.dev/v1
VITE_APP_SITE_URL=https://hubdigital-web-staging.codeisland1460.workers.dev
# VITE_APP_ASSETS_URL=
# VITE_APP_UMAMI_WEBSITE_ID=
